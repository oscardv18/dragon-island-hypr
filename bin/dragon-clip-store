#!/usr/bin/env bash
# wl-paste --type text|image --watch dragon-clip-store
# Keeps phase-2 recording pause; rejects password hints and stores only metadata beside cliphist.
set -Eeuo pipefail
ENGINE_BIN="$(readlink -f -- "${BASH_SOURCE[0]}")"
ENGINE_LIB="$(dirname -- "$(dirname -- "$ENGINE_BIN")")/dragon-core/dragon_clip_store.py"
if [[ ! -f "$ENGINE_LIB" ]]; then
    ENGINE_LIB="${XDG_DATA_HOME:-$HOME/.local/share}/dragon-island/engines/dragon_clip_store.py"
fi
exec python3 "$ENGINE_LIB" "$@"
