#!/usr/bin/env bash
# Read-only daily token totals, resolved in the repo or installed engine directory.
set -Eeuo pipefail
MEM_BIN="$(readlink -f -- "${BASH_SOURCE[0]}")"
MEM_ROOT="$(dirname -- "$(dirname -- "$MEM_BIN")")"
MEM_LIB="$MEM_ROOT/dragon-core/dragon_tokens.py"
[[ -f "$MEM_LIB" ]] || MEM_LIB="${XDG_DATA_HOME:-$HOME/.local/share}/dragon-island/engines/dragon_tokens.py"
exec python3 -S "$MEM_LIB" "$@"
