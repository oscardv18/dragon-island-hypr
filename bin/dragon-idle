#!/usr/bin/env bash
# dragon-island — the idle sequence (docs/design/26-inactividad.png), from ~/.config/dragon-island/settings.json:
#   idleDimSeconds (240)        qs ipc call idle warn → the island warns and a black layer dims the screen to 0.6;
#                               moving the mouse: qs ipc call idle resume
#   idleLockSeconds (300)       loginctl lock-session → the Quickshell lock (hyprlock as fallback)
#   idleScreenOffSeconds (330)  dpms off (on again on resume)
#   idleSuspendSeconds (1200)   systemctl suspend
# hypridle only reads its config when it starts, so the config is generated here:
#   dragon-idle write     write ~/.local/state/dragon-island/hypridle.conf
#   dragon-idle run       write it and exec hypridle with it (autostart)
#   dragon-idle restart   write it and restart hypridle (Quickshell runs this when a time changes in Ajustes)
# Without jq or settings.json the defaults above are used. Inhibitors (an agent working, the recording mode, video)
# live in Quickshell: an IdleInhibitor stops the whole sequence.
set -u
state="${XDG_STATE_HOME:-$HOME/.local/state}/dragon-island"
conf="$state/hypridle.conf"
settings="${XDG_CONFIG_HOME:-$HOME/.config}/dragon-island/settings.json"

val() {   # val <key> <default>: a positive integer from settings.json
    local v=""
    if command -v jq >/dev/null 2>&1 && [[ -r $settings ]]; then
        v=$(jq -r --arg k "$1" '.[$k] // empty | select(type == "number") | floor' "$settings" 2>/dev/null)
    fi
    [[ $v =~ ^[0-9]+$ ]] && (( v > 0 )) && echo "$v" || echo "$2"
}

write() {
    local dim lock off sleep_
    dim=$(val idleDimSeconds 240); lock=$(val idleLockSeconds 300)
    off=$(val idleScreenOffSeconds 330); sleep_=$(val idleSuspendSeconds 1200)
    mkdir -p "$state"
    cat > "$conf.tmp" <<CONF
# generated by dragon-idle from settings.json — edit the times in Ajustes › Energía, not here
general {
    lock_cmd = pidof hyprlock || qs ipc call lock lock || hyprlock
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })'
    inhibit_sleep = 2
}

# 1. warn in the island and dim the screen (Quickshell layer dragon-dim)
listener {
    timeout = $dim
    on-timeout = qs ipc call idle warn
    on-resume = qs ipc call idle resume
}

# 2. lock
listener {
    timeout = $lock
    on-timeout = loginctl lock-session
}

# 3. screens off
listener {
    timeout = $off
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })'
}

# 4. suspend
listener {
    timeout = $sleep_
    on-timeout = systemctl suspend
}
CONF
    mv -f "$conf.tmp" "$conf"
}

case "${1:-write}" in
    write)   write ;;
    run)     write; exec hypridle -c "$conf" ;;
    restart) write; pkill -x hypridle; setsid -f hypridle -c "$conf" >/dev/null 2>&1 </dev/null ;;
    *)       echo "uso: dragon-idle write|run|restart" >&2; exit 2 ;;
esac
