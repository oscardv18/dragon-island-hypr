#!/usr/bin/env python3
"""Fake dragon-gate (§5.4): progress lines, then the final JSON. FAKE_GATE_EXIT picks the test result."""
import json, os, sys, time
args = sys.argv[1:]
if not args or args[0] != 'run':
    print(json.dumps({'ok': False, 'error': {'code': 'invalid_usage', 'message': 'uso', 'hint': ''}})); sys.exit(2)
code = int(os.environ.get('FAKE_GATE_EXIT', '0'))
for i in range(3):
    print(json.dumps({'t': 'progress', 'line': f'test {i + 1} ok'}), flush=True); time.sleep(0.05)
print(json.dumps({'ok': True, 'exit': code, 'seconds': 1, 'tail': ['3 passed' if code == 0 else '1 failed']}), flush=True)
