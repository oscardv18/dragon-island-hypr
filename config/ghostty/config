# =============================================================================
# dragon-island — Ghostty (main terminal). Sweet / Garuda Dragonized palette (references/design.md)
# Options checked with `ghostty +show-config --default --docs`.
# =============================================================================

# Typography
# font-family = JetBrains Mono Nerd Font
# font-family = JetBrainsMono NF SemiBold
# font-family = Liga SFMonoNerdFont
font-family = CaskaydiaCove NF SemiBold
# font-family = Hack Nerd Font
font-size = 10.5

# Transparency: Ghostty makes its background see-through and the compositor blurs what is behind it (native blur with
# the ahumado / clásico glass, hyprglass with líquido). background-blur MUST be true: since Ghostty 1.4 + Hyprland 0.57
# Ghostty asks the compositor for its background blur, and `false` made Hyprland leave the wallpaper sharp behind it
# (kitty never asks, so it was blurred). Migration 039 fixes copied configs.
# background-opacity = 0.65
background-opacity = 0.89
background-blur = true

# Window decorations: none. No window has a title bar in dragon-island (the frame of the focused window — a top
# line and four corner brackets — is drawn by Quickshell; close / maximize / float are SUPER + Q / F / SHIFT + Space),
# so Ghostty's own GTK header bar stays off too and the terminal gets the whole window.
window-decoration = none
# GTK header bar / tab strip: off too, so no opaque strip across the top of the glass (tabs only appear with 2+)
gtk-titlebar = false
window-show-tab-bar = auto
window-padding-x = 12
window-padding-y = 10
confirm-close-surface = false
quit-after-last-window-closed = true

# Cursor
cursor-style = bar
cursor-style-blink = true
cursor-color = #c50ed2
cursor-text = #0b0c14

# Selection and colors
foreground = #e6e8ef
background = #0b0c14
selection-foreground = #ffffff
selection-background = #7c3aed

palette = 0=#161925
palette = 1=#ed254e
palette = 2=#06c993
palette = 3=#f9ae58
palette = 4=#7c3aed
palette = 5=#c50ed2
palette = 6=#00c1e4
palette = 7=#c3c7d1
palette = 8=#3a3d55
palette = 9=#f15274
palette = 10=#2fdba9
palette = 11=#fbc27f
palette = 12=#945df0
palette = 13=#db3fe6
palette = 14=#38d3ef
palette = 15=#e6e8ef

# The shell is your login shell (zsh after the "Shell: zsh + starship" component); shell integration is automatic
shell-integration = detect
